# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Providers ---
# Gemini: vision analysis + embeddings for the RAG store
GOOGLE_API_KEY=

# Claude: structured scoring pass
ANTHROPIC_API_KEY=

# --- Provider selection (see app/container.py) ---
VISION_PROVIDER=gemini
SCORING_PROVIDER=claude

# --- Optional ---
# Lock CORS to a single origin in production; defaults to localhost dev origins.
# FRONTEND_ORIGIN=http://localhost:5173
# DATABASE_URL=sqlite+aiosqlite:///./backend/storage/app.db
